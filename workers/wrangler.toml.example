name = "pantheon-atlas-community-sync"
main = "item-upload-worker.js"
compatibility_date = "2026-06-15"

[[r2_buckets]]
binding = "ITEM_BUCKET"
bucket_name = "pantheon-item-database"

[vars]
PUBLIC_BASE_URL = "https://your-public-r2-domain.r2.dev"
ITEM_OBJECT_PREFIX = "contributions"
MOB_OBJECT_PREFIX = "mob-contributions"
ICON_OBJECT_PREFIX = "item-icons"

# Optional:
# Set this as a Worker secret, not in this file:
# wrangler secret put ATLAS_UPLOAD_TOKEN
